# ---- which AI to use: gemini | meta ----
LLM_PROVIDER=gemini
# Optional fallback provider. Leave empty to disable.
LLM_FALLBACK=

# ---- Gemini ----
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# ---- Meta (Muse) ----
META_API_KEY=
META_MODEL=muse-spark-1.1
META_API_BASE=https://api.meta.ai/v1
META_REASONING_EFFORT=minimal
META_JSON_MODE=0

# ---- Docker frontend port ----
APP_PORT=8080
